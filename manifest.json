{
  "manifest_version": 3,
  "name": "Unicorn Revealer",
  "description": "Do you have overflow on your website and want to try find it? Sparkle some 🦄🌈 on your website and find where it is.",
  "version": "1.1.0",
  "icons": {
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["dist/unicorn.js"],
    "css": ["dist/styles.css"],
    "run_at": "document_end"
  }],
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "128": "images/icon-128.png"
    },
    "default_popup": "dist/popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["dist/*.js", "dist/*.css"],
    "matches": ["<all_urls>"]
  }],
  "commands": {
    "toggle-revealer": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Unicorn Revealer"
    }
  }
}
